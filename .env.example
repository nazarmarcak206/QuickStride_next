# Серверні секрети QuickStride CRM. Копіюйте цей файл у .env і заповнюйте —
# .env не комітиться і читається лише кодом під app/api/ на сервері.

# Токен бота з @BotFather. Ним сервер перевіряє HMAC-підпис initData.
TELEGRAM_BOT_TOKEN=

# Дані проєкту Supabase (Project Settings → API).
# Саме service_role ключ: він обходить RLS і мусить жити тільки на сервері.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Секрет підпису сесійних cookie-токенів, щонайменше 32 символи.
# Згенерувати: openssl rand -base64 48
SESSION_SECRET=

# Необов'язкове (значення за замовчуванням у дужках):
# Скільки часу вважати initData свіжим (86400 = 24 години).
# TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
# Строк життя сесії у секундах (2592000 = 30 днів).
# SESSION_TTL_SECONDS=2592000

# Локальний режим розробки БЕЗ Telegram (тільки для DEVELOPMENT).
# У продакшн-білді маршрут /api/auth/dev завжди відповідає 404, незалежно від
# цих значень. Свій власний числовий Telegram id можна дізнати у @userinfobot.
# DEV_LOGIN=true
# DEV_TELEGRAM_USER_ID=
# NEXT_PUBLIC_DEV_LOGIN=true   # дозволяє клієнту викликати dev-вхід у dev-білді
